{
	"name": "blog.clivemurray.com",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"start": "npx @11ty/eleventy --input=./src --serve",
		"build": "npm-run-all prettier build:assets build:images",
		"build:assets": "npx sn-assets-pipeline build",
		"build:images": "node tooling/process-images.js",
		"prettier": "npx prettier . -w",
		"dev": "npm run build && npm-run-all --parallel start watch",
		"watch": "npm-run-all --parallel watch:assets watch:images",
		"watch:assets": "npx sn-assets-pipeline watch",
		"watch:images": "onchange './src/assets/images/**/*' -- npm run build:images"
	},
	"keywords": [],
	"author": "",
	"type": "module",
	"license": "ISC",
	"browserslist": [
		">0.3%, last 5 versions, not dead"
	],
	"engines": {
		"node": "24.14.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-plugin-rss": "^1.2.0",
		"@eslint/js": "^9.35.0",
		"@springernature/assets-pipeline": "^0.3.1",
		"@springernature/eslint-config": "^8.0.0",
		"@springernature/stylelint-config": "^4.0.0",
		"dayjs": "^1.11.8",
		"eslint": "^9.39.3",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-use-extend-native": "^0.7.2",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-unicorn": "^63.0.0",
		"fsevents": "^2.3.3",
		"globals": "^16.4.0",
		"markdown-it-abbr": "^2.0.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-attrs": "^4.3.1",
		"markdown-it-footnote": "^4.0.0",
		"moment": "^2.29.4",
		"npm-run-all2": "^8.0.4",
		"onchange": "^7.1.0",
		"pos": "^0.4.2",
		"prettier": "^3.9.6",
		"sharp": "^0.35.3",
		"stylelint": "^17.12.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"stylelint-order": "^8.1.1",
		"svgo": "^4.0.1"
	}
}
